{
  "name": "sikeoop",
  "productName": "sikeoop",
  "version": "4.1.68",
  "private": true,
  "description": "给新手的粉色 AI 代码编辑器",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-with-builtin-env.mjs dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "node scripts/build-with-builtin-env.mjs",
    "start": "electron-vite preview",
    "test": "node --test --test-timeout=10000 \"test/**/*.test.ts\"",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dist:win": "node scripts/win-natives.mjs && npm run build && electron-builder --win --x64",
    "dist:mac": "node scripts/mac-natives.mjs && npm run build && electron-builder --mac",
    "dist:all": "node scripts/win-natives.mjs && node scripts/mac-natives.mjs && npm run build && electron-builder --win --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@arkts/language-server": "^1.3.10",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@wechatbot/wechatbot": "^2.2.0",
    "electron-updater": "6.3.9",
    "fflate": "^0.8.3",
    "jsonc-parser": "3.3.1",
    "node-pty": "^1.1.0",
    "openai": "^7.28.0",
    "pdfjs-dist": "^6.4.299",
    "tinyglobby": "^0.2.17",
    "uiohook-napi": "^1.5.5",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.57.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  },
  "build": {
    "appId": "com.sikeoop.app",
    "productName": "sikeoop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      { "from": "resources/ai-search", "to": "ai-search" },
      {
        "from": "resources/chain-centric",
        "to": "chain-centric"
      },
      {
        "from": "resources/pv-packs",
        "to": "pv-packs"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "../game-cheat-workshop",
        "to": "cheatshop"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/uiohook-napi/**",
      "node_modules/pdfjs-dist/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "sikeoop",
      "uninstallDisplayName": "sikeoop",
      "artifactName": "sikeoop-${version}-setup.exe"
    },
    "portable": {
      "artifactName": "sikeoop-${version}-portable.exe"
    },
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "sikeoop 用麦克风做语音输入：你说的话会转成文字发给 AI。"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "sikeoop-${version}-${arch}.dmg",
      "title": "sikeoop ${version}"
    },
    "releaseInfo": {
      "releaseNotesFile": "../更新公告/sikeoop-4.1.68.md"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://sikeoop.modgert.online/download/"
      }
    ]
  },
  "optionalDependencies": {
    "@ohos-rs/oxk-win32-x64-msvc": "^0.2.2"
  }
}
