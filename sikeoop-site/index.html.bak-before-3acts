<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="sikeoop：给新手的 AI 代码编辑器。改什么、跑什么，都先问你。">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<title>sikeoop</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=ZCOOL+QingKe+HuangYou&family=Noto+Sans+SC:wght@400;500;700&display=swap">
<style>
/* Layout: a dusk-sea hero with the whale breaching, then the product itself as the evidence —
   a working window mock, the three ways of working side by side, the memory as four tide bands. */
:root {
  /* the app's own palette: dark shell, one rose accent */
  --bg: #0f0f10;
  --panel: #151517;
  --raised: #1c1c20;
  --line: #26262b;
  --ink: #ecebef;
  --ink-2: #c4c3cb;
  --muted: #8d8b96;
  --accent: #f0789b;
  --accent-soft: rgba(240, 120, 155, 0.13);
  --accent-ink: #1a0d12;
  --ok: #5fd38d;
  --add-bg: rgba(95, 211, 141, 0.11);
  --add-ink: #7fdca3;
  --del-bg: rgba(242, 118, 122, 0.11);
  --del-ink: #f59a9d;
  --warn: #e5a15b;
  /* the sea of the opening shot: the same in both themes */
  --sea-top: #070816;
  --sea-mid: #1d0f2a;
  --sea-glow: #5a2742;
  --sea-ink: #f5e9ef;
  --sea-muted: #c9b2c0;
  --font-display: "ZCOOL QingKe HuangYou", "Hannotate SC", "Yuanti SC", "PingFang SC", sans-serif;
  --font-body: "Geist", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  --font-mono: "Geist Mono", "SF Mono", Menlo, Consolas, monospace;
  --radius: 10px;
  color-scheme: dark;
}
@media (prefers-color-scheme: light) {
  :root:not([data-theme="dark"]) {
    --bg: #fbf8f9; --panel: #f3eef1; --raised: #ffffff; --line: #e6dde2;
    --ink: #1e1a1d; --ink-2: #3d363b; --muted: #776e75;
    --accent: #d14c76; --accent-soft: rgba(209, 76, 118, 0.1); --accent-ink: #ffffff;
    --ok: #23935a; --add-bg: rgba(35, 147, 90, 0.1); --add-ink: #1d7a4b; --del-bg: rgba(200, 60, 66, 0.09); --del-ink: #b23a40;
    --warn: #b56b1f;
    color-scheme: light;
  }
}
:root[data-theme="light"] {
  --bg: #fbf8f9; --panel: #f3eef1; --raised: #ffffff; --line: #e6dde2;
  --ink: #1e1a1d; --ink-2: #3d363b; --muted: #776e75;
  --accent: #d14c76; --accent-soft: rgba(209, 76, 118, 0.1); --accent-ink: #ffffff;
  --ok: #23935a; --add-bg: rgba(35, 147, 90, 0.1); --add-ink: #1d7a4b; --del-bg: rgba(200, 60, 66, 0.09); --del-ink: #b23a40;
  --warn: #b56b1f;
  color-scheme: light;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.7 var(--font-body); -webkit-font-smoothing: antialiased; }
a { color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
.wrap { width: 100%; max-width: 1120px; margin-inline: auto; padding-inline: 24px; }
@media (max-width: 520px) { .wrap { padding-inline: 16px; } }
h1, h2, h3 { text-wrap: balance; margin: 0; }
h2 { font: 400 clamp(28px, 4.2vw, 42px)/1.25 var(--font-display); letter-spacing: 0.01em; }
.eyebrow { font: 500 12.5px/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
.lede { color: var(--ink-2); max-width: 36em; font-size: 17px; }
section { padding-block: clamp(64px, 9vw, 112px); }
.sec-head { display: grid; gap: 14px; margin-bottom: 44px; }

/* ---- top bar (over the sea) ---- */
.top { position: absolute; inset: 0 0 auto 0; z-index: 3; padding-top: env(safe-area-inset-top, 0px); }
.top .wrap { display: flex; align-items: center; gap: 28px; height: 68px; }
.brand { display: inline-flex; align-items: center; gap: 9px; font: 600 18px/1 var(--font-body); color: var(--sea-ink); text-decoration: none; letter-spacing: 0.01em; }
.brand svg { width: 20px; height: 20px; }
.top nav { display: flex; gap: 24px; margin-left: auto; }
.top nav a { color: var(--sea-muted); text-decoration: none; font-size: 14.5px; }
.top nav a:hover { color: var(--sea-ink); }
.top .get { color: var(--sea-ink); border: 1px solid rgba(245, 233, 239, 0.28); padding: 7px 14px; border-radius: 999px; font-size: 14px; text-decoration: none; }
.top .get:hover { border-color: #f0789b; color: #ffd3e0; }
@media (max-width: 760px) { .top nav { display: none; } .top .get { margin-left: auto; } }

/* ---- hero: the dusk sea ---- */
.hero { position: relative; overflow: hidden; background: linear-gradient(180deg, var(--sea-top) 0%, var(--sea-mid) 52%, var(--sea-glow) 66%, var(--sea-top) 100%); color: var(--sea-ink); }
.hero canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.hero-copy { position: relative; z-index: 2; padding-block: 148px 0; display: grid; gap: 22px; justify-items: start; }
.hero h1 { font: 400 clamp(38px, 7.2vw, 84px)/1.12 var(--font-display); letter-spacing: 0.01em; max-width: 11.5em; }
.hero h1 em { font-style: normal; color: #ff9cbb; }
.hero p.sub { margin: 0; color: var(--sea-muted); font-size: clamp(16px, 1.8vw, 19px); max-width: 30em; }
.ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 6px; }
.btn { display: inline-flex; align-items: center; gap: 9px; height: 46px; padding: 0 22px; border-radius: 999px; font: 500 15.5px/1 var(--font-body); text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: transform 0.15s ease, background 0.15s ease; }
.btn:hover { transform: translateY(-1px); }
.btn.primary { background: #f0789b; color: #1a0d12; }
.btn.primary:hover { background: #ff8fb0; }
.btn.ghost { color: var(--sea-ink); border-color: rgba(245, 233, 239, 0.3); }
.btn.ghost:hover { border-color: rgba(245, 233, 239, 0.6); }
.btn svg { width: 18px; height: 18px; }
.free-note { font: 400 13px/1.5 var(--font-mono); color: var(--sea-muted); }
.free-note b { color: #ffc2d4; font-weight: 500; }

/* the product window rises out of the water */
.shot { position: relative; z-index: 2; margin-top: 64px; margin-bottom: -1px; }
.window { border-radius: 14px 14px 0 0; border: 1px solid rgba(255, 255, 255, 0.09); border-bottom: 0; background: #121214; box-shadow: 0 -20px 80px rgba(240, 120, 155, 0.12), 0 30px 80px rgba(0, 0, 0, 0.5); overflow: hidden; color: #e7e7ea; }
.win-bar { display: flex; align-items: center; gap: 10px; height: 38px; padding: 0 14px; background: #0f0f10; border-bottom: 1px solid #222226; font: 500 12.5px/1 var(--font-body); color: #8b8b93; }
.dots { display: flex; gap: 7px; }
.dots i { width: 11px; height: 11px; border-radius: 50%; background: #2c2c31; }
.win-bar .title { display: inline-flex; gap: 7px; align-items: center; color: #e7e7ea; }
.win-bar .title svg { width: 13px; height: 13px; }
.win-bar .mono { font-family: var(--font-mono); }
.win-body { display: grid; grid-template-columns: 190px minmax(0, 1fr) minmax(0, 400px); min-height: 420px; }
.files { background: #151517; border-right: 1px solid #222226; padding: 12px 10px; font: 13px/2 var(--font-mono); color: #a9a9b1; }
.files .h { font: 500 11px/1 var(--font-body); letter-spacing: 0.1em; color: #6c6c75; margin: 2px 6px 10px; }
.files div { padding-left: 8px; border-radius: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.files .on { background: #232328; color: #e7e7ea; }
.files .in { padding-left: 22px; }
.editor { padding: 14px 0; font: 13px/1.85 var(--font-mono); color: #c9c9cf; overflow: hidden; min-width: 0; }
.editor .ln { display: grid; grid-template-columns: 44px 1fr; white-space: pre; }
.editor .ln span:first-child { color: #4d4d55; text-align: right; padding-right: 16px; }
.k { color: #f0789b; } .s { color: #9fd6a8; } .p { color: #8fb8ff; } .c { color: #6c6c75; }
.chat { background: #151517; border-left: 1px solid #222226; padding: 16px; display: grid; align-content: start; gap: 12px; font-size: 13.5px; line-height: 1.65; min-width: 0; }
.bubble-me { justify-self: end; background: #232328; padding: 8px 12px; border-radius: 12px 12px 4px 12px; max-width: 85%; }
.ai { display: grid; gap: 10px; }
.ai-who { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; color: #8b8b93; }
.ai-who .av { width: 20px; height: 20px; border-radius: 50%; background: #7fb0e8; display: grid; place-items: center; }
.ai-who .av svg { width: 14px; height: 14px; }
.ai p { margin: 0; color: #dcdce1; }
.tail { color: #8b8b93; }
.diff-card { border: 1px solid #2c2c31; border-radius: 9px; overflow: hidden; background: #121213; }
.diff-head { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-bottom: 1px solid #222226; font: 12px/1 var(--font-mono); color: #a9a9b1; }
.diff-head b { color: #e7e7ea; font-weight: 500; }
.diff-head .stat { margin-left: auto; display: flex; gap: 6px; align-items: center; }
.diff-head .plus { color: #7fdca3; } .diff-head .minus { color: #f59a9d; }
.blocks { display: inline-flex; gap: 2px; }
.blocks i { width: 7px; height: 7px; border-radius: 1.5px; background: #2c2c31; }
.blocks i.a { background: #5fd38d; } .blocks i.d { background: #f2767a; }
.dl { display: grid; grid-template-columns: 30px 1fr; font: 12px/1.9 var(--font-mono); white-space: pre; overflow: hidden; }
.dl span:first-child { color: #55555d; text-align: right; padding-right: 8px; }
.dl.del { background: rgba(242, 118, 122, 0.1); color: #f59a9d; }
.dl.add { background: rgba(95, 211, 141, 0.1); color: #a5e7bd; }
.dl mark { background: rgba(95, 211, 141, 0.28); color: inherit; border-radius: 2px; padding: 0 1px; }
.dl.del mark { background: rgba(242, 118, 122, 0.3); }
.diff-why { padding: 8px 10px; font-size: 12.5px; color: #a9a9b1; border-top: 1px solid #222226; }
.diff-acts { display: flex; gap: 8px; padding: 0 10px 10px; }
.diff-acts span { font-size: 12px; padding: 5px 12px; border-radius: 6px; border: 1px solid #2c2c31; color: #c9c9cf; }
.diff-acts span.yes { background: #e7e7ea; color: #121213; border-color: #e7e7ea; }
.composer { margin-top: 4px; border: 1px solid #2c2c31; border-radius: 10px; padding: 10px 12px; color: #6c6c75; font-size: 12.5px; display: grid; gap: 8px; }
.composer .row { display: flex; gap: 8px; }
.composer .pill { background: #1c1c20; border-radius: 6px; padding: 3px 9px; color: #c9c9cf; }
.composer .pill.lazy { background: rgba(229, 161, 91, 0.16); color: #e5a15b; }
@media (max-width: 980px) { .win-body { grid-template-columns: minmax(0, 1fr) minmax(0, 380px); } .files { display: none; } }
@media (max-width: 720px) { .win-body { grid-template-columns: minmax(0, 1fr); } .editor { display: none; } .chat { border-left: 0; } }

/* ---- three promises ---- */
.promises { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line); }
.promise { padding: 28px 28px 8px 0; display: grid; gap: 10px; align-content: start; }
.promise + .promise { padding-left: 28px; border-left: 1px solid var(--line); }
.promise h3 { font: 700 19px/1.4 var(--font-body); }
.promise p { margin: 0; color: var(--ink-2); font-size: 15px; }
.promise .tag { font: 500 12px/1 var(--font-mono); color: var(--muted); }
@media (max-width: 820px) {
  .promises { grid-template-columns: minmax(0, 1fr); }
  .promise, .promise + .promise { padding: 24px 0; border-left: 0; }
  .promise + .promise { border-top: 1px solid var(--line); }
}

/* ---- modes ---- */
.modes-band { background: var(--panel); border-block: 1px solid var(--line); }
.table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--raised); }
table.modes { width: 100%; min-width: 680px; border-collapse: collapse; font-size: 15px; }
.modes th, .modes td { text-align: left; padding: 16px 20px; border-bottom: 1px solid var(--line); vertical-align: top; }
.modes tr:last-child td { border-bottom: 0; }
.modes thead th { font: 500 13px/1.4 var(--font-body); color: var(--muted); }
.modes thead th .name { display: block; font: 700 20px/1.3 var(--font-body); color: var(--ink); margin-top: 4px; }
.modes thead th.lazy .name { color: var(--warn); }
.modes tbody th { font-weight: 500; color: var(--muted); width: 22%; font-size: 14px; }
.modes td { color: var(--ink-2); }
.chip { display: inline-block; font: 500 12.5px/1 var(--font-mono); padding: 5px 9px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); white-space: nowrap; }
.chip.warn { background: color-mix(in srgb, var(--warn) 15%, transparent); color: var(--warn); }
.chip.ok { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); }
.note { margin-top: 16px; color: var(--muted); font-size: 14px; max-width: 46em; }

/* ---- ask first ---- */
.split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 72px); align-items: center; }
@media (max-width: 860px) { .split { grid-template-columns: minmax(0, 1fr); } }
.steps { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 18px; counter-reset: s; }
.steps li { display: grid; grid-template-columns: 32px 1fr; gap: 14px; counter-increment: s; }
.steps li::before { content: counter(s); width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line); display: grid; place-items: center; font: 500 13px/1 var(--font-mono); color: var(--accent); }
.steps b { display: block; font-weight: 600; }
.steps span { color: var(--ink-2); font-size: 15px; }
.qcard { border: 1px solid var(--line); border-radius: 14px; background: var(--raised); padding: 20px; display: grid; gap: 14px; font-size: 14.5px; }
.qcard header { display: flex; gap: 8px; align-items: center; font-weight: 600; }
.qcard header svg { width: 17px; height: 17px; color: var(--accent); }
.q legend { display: flex; gap: 8px; align-items: center; font-weight: 500; margin-bottom: 10px; }
.q legend .n { width: 20px; height: 20px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; font: 500 11.5px/1 var(--font-mono); }
.q legend .h { font: 500 11.5px/1 var(--font-mono); color: var(--muted); border: 1px solid var(--line); padding: 3px 6px; border-radius: 5px; }
.q { border: 0; margin: 0; padding: 0; }
.opt { display: grid; grid-template-columns: 18px 1fr; gap: 10px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; margin-top: 8px; }
.opt.on { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); background: var(--accent-soft); }
.opt .m { width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--muted); margin-top: 3px; }
.opt.on .m { border-color: var(--accent); background: radial-gradient(circle, var(--accent) 45%, transparent 50%); }
.opt b { font-weight: 500; }
.opt .rec { font: 500 11px/1 var(--font-mono); background: var(--accent); color: var(--accent-ink); padding: 3px 6px; border-radius: 4px; margin-left: 6px; vertical-align: 2px; }
.opt small { display: block; color: var(--muted); font-size: 13px; line-height: 1.55; }
.qcard footer { display: flex; justify-content: flex-end; gap: 8px; }
.qcard footer span { font-size: 13px; padding: 7px 14px; border-radius: 7px; border: 1px solid var(--line); }
.qcard footer span.go { background: var(--ink); color: var(--bg); border-color: var(--ink); }

/* ---- partners ---- */
.partners { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
.partner { display: inline-flex; flex-direction: column; gap: 2px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 10px; min-width: 150px; }
.partner b { font-weight: 600; font-size: 15px; }
.partner span { font: 400 12.5px/1.4 var(--font-mono); color: var(--muted); }
.partner.free { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); }
.partner.free span { color: var(--accent); }

/* ---- memory as tide bands ---- */
.tides { display: grid; gap: 0; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
.tide { display: grid; grid-template-columns: 74px minmax(0, 1fr) minmax(0, 1.1fr) 170px; gap: 20px; align-items: center; padding: 18px 22px; border-top: 1px solid var(--line); position: relative; }
.tide:first-child { border-top: 0; }
.tide .lv { font: 600 22px/1 var(--font-mono); color: var(--accent); }
.tide b { font-weight: 600; display: block; }
.tide .what { color: var(--muted); font-size: 14px; }
.tide p { margin: 0; color: var(--ink-2); font-size: 14.5px; }
.tide .speed { font: 400 12.5px/1.4 var(--font-mono); color: var(--muted); text-align: right; }
.tide::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--accent); opacity: var(--o); }
@media (max-width: 860px) {
  .tide { grid-template-columns: 52px minmax(0, 1fr); gap: 8px 14px; }
  .tide p, .tide .speed { grid-column: 2; text-align: left; }
}

/* ---- safety ---- */
.safety { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
@media (max-width: 760px) { .safety { grid-template-columns: minmax(0, 1fr); } }
.safe { padding: 22px; border: 1px solid var(--line); border-radius: 12px; display: grid; gap: 8px; align-content: start; }
.safe h3 { font: 600 17px/1.4 var(--font-body); }
.safe p { margin: 0; color: var(--ink-2); font-size: 14.5px; }
.safe code { font: 12.5px/1.6 var(--font-mono); background: var(--panel); border: 1px solid var(--line); padding: 1px 6px; border-radius: 5px; color: var(--ink); }

/* ---- download ---- */
.dl-band { background: linear-gradient(180deg, var(--bg), var(--panel)); border-top: 1px solid var(--line); }
.downloads { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
@media (max-width: 760px) { .downloads { grid-template-columns: minmax(0, 1fr); } }
.dlc { border: 1px solid var(--line); border-radius: 14px; padding: 24px; background: var(--raised); display: grid; gap: 14px; align-content: start; }
.dlc h3 { display: flex; align-items: baseline; gap: 10px; font: 700 22px/1.3 var(--font-body); }
.dlc h3 small { font: 400 13px/1 var(--font-mono); color: var(--muted); }
.dlc ul { margin: 0; padding-left: 1.1em; color: var(--ink-2); font-size: 14.5px; display: grid; gap: 4px; }
.files-list { display: grid; gap: 8px; }
.file { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 14.5px; }
.file code { font: 13px/1.4 var(--font-mono); color: var(--ink); overflow-wrap: anywhere; min-width: 0; }
.file span { margin-left: auto; font: 12.5px/1 var(--font-mono); color: var(--muted); white-space: nowrap; }
a.file { text-decoration: none; color: inherit; transition: border-color 0.15s ease, background 0.15s ease; }
a.file:hover { border-color: var(--accent); background: var(--accent-soft); }
a.file::after { content: "↓"; color: var(--accent); font-weight: 600; margin-left: 4px; }
.file.soon { opacity: 0.55; }
.status a { color: var(--accent); }
.status { font-size: 13.5px; color: var(--muted); }
.status b { color: var(--accent); font-weight: 500; }

footer.site { border-top: 1px solid var(--line); padding-block: 28px; color: var(--muted); font-size: 13.5px; }
footer.site .wrap { display: flex; flex-wrap: wrap; gap: 10px 24px; align-items: center; }
footer.site .wrap > :last-child { margin-left: auto; }
@media (max-width: 600px) { footer.site .wrap > :last-child { margin-left: 0; } }

/* ---- the story: a sticky stage the scroll moves the camera through ---- */
.story { position: relative; height: 420vh; background: linear-gradient(180deg, var(--sea-top) 0%, var(--sea-mid) 52%, var(--sea-glow) 66%, var(--sea-top) 100%); color: var(--sea-ink); }
.stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
.stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: pointer; }
.cap { position: absolute; inset: 0; display: grid; pointer-events: none; opacity: 0; will-change: opacity, transform; }
.cap a, .cap button { pointer-events: auto; }
.cap-a { opacity: 1; align-content: start; }
.cap-a .hero-copy { padding-top: 140px; }
.cap-b { align-content: end; padding-bottom: 16vh; }
.cap-c { align-content: end; padding-bottom: 12vh; text-align: center; }
.cap-c .wrap { display: grid; justify-items: center; }
.cap-d { align-content: end; padding-bottom: 7vh; text-align: center; }
