<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// The opening as one camera move, driven by scroll (scrolling back plays it backwards):
//   A  high above the dusk sea, the headline in the sky
//   B  down at the waterline, the whale breaches past the camera, rolls and dives
//   C  the spray gathers into the sikeoop heart, the camera pulls back
//   D  the camera tips down to the water, and the app window comes up below
// The sea is summed Gerstner waves with analytic normals, Fresnel sky reflection and ring waves.
// Interaction: the camera leans toward the pointer; clicking the sea makes a ripple and spray;
// clicking the whale gets an answer back. Reduced motion or no WebGL: one still frame.
(() => {
  const story = document.getElementById("story");
  const canvas = document.getElementById("sea");
  const caps = [...story.querySelectorAll(".cap")];
  const hint = document.getElementById("hint");
  const tease = document.getElementById("tease");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let renderer;
  try {
    if (!window.THREE) throw new Error("no three");
    renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
  } catch (e) {
    story.classList.add("still");
    canvas.style.display = "none";
    return;
  }
  if (reduce) story.classList.add("still");

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 400);
  const SUN = new THREE.Vector3(0.32, 0.05, -1).normalize();

  // ---- shared GLSL: the sky ----
  const SKY = `
    uniform vec3 uSun;
    vec3 sky(vec3 d) {
      float y = d.y;
      vec3 top = vec3(0.027, 0.03, 0.09), mid = vec3(0.17, 0.07, 0.21), low = vec3(0.62, 0.27, 0.38);
      vec3 up = mix(mid, top, smoothstep(0.05, 0.5, y));
      vec3 c = mix(low, up, smoothstep(-0.01, 0.16, y));
      float s = max(dot(d, uSun), 0.0);
      c += vec3(1.0, 0.55, 0.62) * pow(s, 24.0) * 0.35;
      c += vec3(1.0, 0.9, 0.88) * pow(s, 1800.0) * 2.0;
      return c;
    }`;

  // ---- sky dome with stars ----
  const skyMat = new THREE.ShaderMaterial({
    side: THREE.BackSide,
    depthWrite: false,
    uniforms: { uSun: { value: SUN } },
    vertexShader: `varying vec3 vDir; void main(){ vDir = normalize((modelMatrix * vec4(position,1.0)).xyz - cameraPosition); gl_Position = projectionMatrix * viewMatrix * modelMatrix * vec4(position,1.0); }`,
    fragmentShader: SKY + `
      varying vec3 vDir;
      void main(){
        vec3 d = normalize(vDir);
        vec3 c = sky(d);
        vec2 cell = floor(d.xz / max(d.y, 0.05) * 60.0);
        float h = fract(sin(dot(cell, vec2(12.9898, 78.233))) * 43758.5453);
        c += vec3(0.95, 0.9, 1.0) * step(0.995, h) * smoothstep(0.2, 0.55, d.y) * 0.75;
        gl_FragColor = vec4(c, 1.0);
      }`,
  });
  const skyMesh = new THREE.Mesh(new THREE.SphereGeometry(300, 32, 16), skyMat);
  scene.add(skyMesh);

  // ---- the sea ----
  const RIPPLES = 6;
  const rip = Array.from({ length: RIPPLES }, () => new THREE.Vector4(0, 0, -99, 0));
  const waterMat = new THREE.ShaderMaterial({
    uniforms: { uTime: { value: 0 }, uSun: { value: SUN }, uRip: { value: rip } },
    vertexShader: `
      uniform float uTime; uniform vec4 uRip[${RIPPLES}];
      varying vec3 vWorld; varying vec3 vN; varying float vFoam; varying float vH;
      void main(){
        vec4 w = modelMatrix * vec4(position, 1.0);
        vec2 p = w.xz;
        float dx = 0.0, dz = 0.0, dy = 0.0, nx = 0.0, nz = 0.0, ny = 1.0, jac = 1.0;
        #define WAVE(DX, DZ, L, ST) { vec2 d = normalize(vec2(DX, DZ)); float k = 6.28318 / L; float c = sqrt(9.8 / k) * 0.75; float a = ST / k * 0.42; float f = k * (dot(d, p) - c * uTime); float cf = cos(f), sf = sin(f); dx += a * d.x * cf; dz += a * d.y * cf; dy += a * sf; nx -= k * a * d.x * cf; nz -= k * a * d.y * cf; ny -= k * a * sf; jac -= k * a * sf; }
        WAVE(1.0, 0.25, 7.5, 0.28) WAVE(0.55, 1.0, 4.4, 0.24) WAVE(-0.75, 0.55, 2.7, 0.2) WAVE(0.2, -1.0, 1.7, 0.16) WAVE(-0.4, -0.9, 1.1, 0.12)
        float foam = smoothstep(0.62, 0.3, jac) * 0.5;
        for (int i = 0; i < ${RIPPLES}; i++) {
          vec4 r = uRip[i];
          float age = uTime - r.z;
          if (age <= 0.0 || r.w <= 0.0) continue;
          vec2 off = p - r.xy;
          float dist = length(off);
          float front = age * 3.4;
          float inside = smoothstep(front + 0.35, front - 0.5, dist);
          float env = exp(-age * 1.4) * exp(-dist * 0.3) * r.w * inside;
          float ph = dist * 5.5 - age * 15.0;
          dy += sin(ph) * env * 0.24;
          float sl = cos(ph) * env * 0.24 * 5.5;
          vec2 d2 = off / max(dist, 0.001);
          nx -= d2.x * sl; nz -= d2.y * sl;
          foam += env * smoothstep(0.6, 1.0, sin(ph)) * 0.45 + r.w * exp(-age * 3.0) * smoothstep(0.8, 0.15, dist) * 0.7;
        }
        w.xyz += vec3(dx, dy, dz);
        vWorld = w.xyz; vN = vec3(nx, ny, nz); vFoam = clamp(foam, 0.0, 1.0); vH = dy;
        gl_Position = projectionMatrix * viewMatrix * w;
      }`,
    fragmentShader: SKY + `
      varying vec3 vWorld; varying vec3 vN; varying float vFoam; varying float vH;
      void main(){
        vec3 n = normalize(vN);
        vec3 v = normalize(cameraPosition - vWorld);
        float fres = 0.02 + 0.98 * pow(1.0 - max(dot(n, v), 0.0), 5.0);
        vec3 r = reflect(-v, n); r.y = max(r.y, 0.01);
        vec3 deep = vec3(0.012, 0.014, 0.04);
        vec3 scatter = vec3(0.5, 0.17, 0.33) * smoothstep(0.0, 0.25, vH) * 0.3;
        vec3 c = mix(deep + scatter, sky(r), fres * 0.9);
        c += vec3(1.0, 0.82, 0.8) * pow(max(dot(r, uSun), 0.0), 380.0) * 2.0;
        c = mix(c, vec3(0.88, 0.78, 0.86), vFoam * 0.75);
        float far = length(vWorld.xz - cameraPosition.xz);
        c = mix(c, vec3(0.42, 0.18, 0.28), smoothstep(30.0, 110.0, far));
        gl_FragColor = vec4(c, 1.0);
      }`,
  });
  const water = new THREE.Mesh(new THREE.PlaneGeometry(240, 240, 300, 300).rotateX(-Math.PI / 2), waterMat);
  water.position.z = -60;
  scene.add(water);

  // ---- the whale: the app's illustration on a card that faces the camera ----
  const WHALE_SVG =
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 100" width="512" height="320">' +
    '<path d="M28 56C16 50 8 40 4 30c10 2 16 8 20 14 0-10 4-18 12-22-2 12 0 22 6 30Z" fill="#7fb0e8"/>' +
    '<path d="M30 58c0-18 22-32 52-32 30 0 52 14 52 34 0 18-22 30-56 30-30 0-48-12-48-32Z" fill="#7fb0e8"/>' +
    '<path d="M40 70c10 10 26 14 42 14 22 0 40-6 48-18-8 6-26 10-46 10-18 0-32-2-44-6Z" fill="#dbe9fa"/>' +
    '<circle cx="112" cy="54" r="4.2" fill="#1a2a3e"/><circle cx="113.4" cy="52.6" r="1.4" fill="#fff"/>' +
    '<ellipse cx="118" cy="64" rx="6" ry="3" fill="#f0789b" opacity="0.6"/>' +
    '<path d="M84 70c4 6 10 8 16 4" fill="none" stroke="#5b8fd0" stroke-width="3" stroke-linecap="round"/></svg>';
  const whaleTex = new THREE.Texture();
  const img = new Image();
  img.onload = () => { whaleTex.image = img; whaleTex.needsUpdate = true; draw(); };
  img.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(WHALE_SVG);
  const whale = new THREE.Mesh(new THREE.PlaneGeometry(2.1, 1.31), new THREE.MeshBasicMaterial({ map: whaleTex, alphaTest: 0.5, side: THREE.DoubleSide }));
  scene.add(whale);

  // ---- spray: a round soft dot texture ----
  const dot = document.createElement("canvas");
  dot.width = dot.height = 64;
  const g = dot.getContext("2d");
  const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
  grad.addColorStop(0, "rgba(255,255,255,1)"); grad.addColorStop(0.4, "rgba(255,255,255,0.7)"); grad.addColorStop(1, "rgba(255,255,255,0)");
  g.fillStyle = grad; g.fillRect(0, 0, 64, 64);
  const dotTex = new THREE.CanvasTexture(dot);
  const sprayMat = (size) => new THREE.PointsMaterial({ size, map: dotTex, color: 0xf27aa0, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, sizeAttenuation: true });

  // Whale path in shot B, the splash points, and the heart for shot C.
  const SHOT_B = [0.28, 0.6];
  const whaleAt = (s) => ({ x: -4.2 + 8.4 * s, y: -1.1 + 4 * s * (1 - s) * 3.3, z: 1.2 });
  // Where the path crosses the water: 13.2 s(1 - s) = 1.1.
  const sCross = (1 - Math.sqrt(1 - 4.4 / 13.2)) / 2;
  const BREACH_SECONDS = 1.6; // how much "time" the breach is worth, for the spray and ripples
  const HEART = new THREE.Vector3(0, 2.05, 4);
  const N = 900;
  let seed = 11;
  const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
  function heartPoint() {
    for (;;) {
      const x = (rnd() * 2 - 1) * 1.15, y = (rnd() * 2 - 1) * 1.15 + 0.1;
      const a = x * x + y * y - 1, v = a * a * a - x * x * y * y * y;
      if (v <= 0 && (v > -0.06 || rnd() < 0.35)) return [x, y - 0.1];
    }
  }
  const parts = Array.from({ length: N }, (_, i) => {
    const second = i % 3 !== 0;
    const at = whaleAt(second ? 1 - sCross : sCross);
    const [hx, hy] = heartPoint();
    return {
      s0: second ? 1 - sCross : sCross,
      o: new THREE.Vector3(at.x + (rnd() - 0.5) * 0.6, 0.05, at.z + (rnd() - 0.5) * 0.5),
      v: new THREE.Vector3((rnd() - 0.5) * 2.4 + (second ? -0.5 : 0.6), 2.4 + rnd() * 3.2, (rnd() - 0.5) * 1.6 + 1.2),
      t: new THREE.Vector3(HEART.x + hx * 0.85, HEART.y + hy * 0.85, HEART.z + (rnd() - 0.5) * 0.15),
      delay: rnd() * 0.25,
    };
  });
  const sprayGeo = new THREE.BufferGeometry();
  const sprayPos = new Float32Array(N * 3);
  sprayGeo.setAttribute("position", new THREE.BufferAttribute(sprayPos, 3));
  const spray = new THREE.Points(sprayGeo, sprayMat(0.085));
  spray.frustumCulled = false;
  scene.add(spray);

  // Clicked spray: its own small pool, in real time.
  const CN = 240;
  const clickPos = new Float32Array(CN * 3).fill(-999);
  const clickVel = new Float32Array(CN * 3);
  const clickLife = new Float32Array(CN);
  let clickNext = 0;
  const clickGeo = new THREE.BufferGeometry();
  clickGeo.setAttribute("position", new THREE.BufferAttribute(clickPos, 3));
  const clickSpray = new THREE.Points(clickGeo, sprayMat(0.07));
  clickSpray.frustumCulled = false;
  scene.add(clickSpray);

  // ---- the camera move: keyframes over scroll progress ----
  const KEYS = [
    { p: 0.0, pos: [0, 7.5, 26], look: [0, 1.8, -20] },
    { p: 0.26, pos: [0, 1.15, 9.5], look: [0, 1.05, 0] },
    { p: 0.6, pos: [0.7, 1.0, 8.6], look: [0.5, 1.15, 0] },
    { p: 0.8, pos: [0, 2.3, 11.2], look: [HEART.x, HEART.y, HEART.z] },
    { p: 1.0, pos: [0, 4.2, 15], look: [0, -0.6, -2] },
  ];
  const ease = (x) => x * x * (3 - 2 * x);
  const easeIO = (x) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const clamp01 = (x) => Math.min(1, Math.max(0, x));
  const camPos = new THREE.Vector3(), camLook = new THREE.Vector3();
  function cameraAt(p) {
    let i = 0;
    while (i < KEYS.length - 2 && p > KEYS[i + 1].p) i++;
    const a = KEYS[i], b = KEYS[i + 1];
    const k = ease(clamp01((p - a.p) / (b.p - a.p)));
    camPos.set(...a.pos).lerp(new THREE.Vector3(...b.pos), k);
    camLook.set(...a.look).lerp(new THREE.Vector3(...b.look), k);
  }

  // ---- input ----
  let progress = 0;
  const lean = { x: 0, y: 0, tx: 0, ty: 0 };
  function readScroll() {
    if (story.classList.contains("still")) return (progress = 0.45);
    const r = story.getBoundingClientRect();
    progress = clamp01(-r.top / Math.max(1, r.height - innerHeight));
  }
  addEventListener("scroll", readScroll, { passive: true });
  canvas.addEventListener("pointermove", (e) => {
    const r = canvas.getBoundingClientRect();
    lean.tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
    lean.ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
  });
  canvas.addEventListener("pointerleave", () => { lean.tx = lean.ty = 0; });

  const ray = new THREE.Raycaster();
  const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
  const LINES = ["杂鱼，点本鲸干嘛～", "（尾巴啪）别戳！", "才不胖！这是流线型！", "想吃米饭……", "看什么看，往下滚啦，废物～", "哼，再点一下试试？"];
  let teaseTimer = 0, lineIndex = 0;
  let rippleNext = 0;
  canvas.addEventListener("click", (e) => {
    const r = canvas.getBoundingClientRect();
    const ndc = new THREE.Vector2(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
    ray.setFromCamera(ndc, camera);
    if (whale.visible && ray.intersectObject(whale).length) {
      tease.textContent = LINES[lineIndex++ % LINES.length];
      tease.style.left = `${e.clientX - r.left + 14}px`;
      tease.style.top = `${e.clientY - r.top - 44}px`;
      tease.classList.add("on");
      clearTimeout(teaseTimer);
      teaseTimer = setTimeout(() => tease.classList.remove("on"), 1800);
      return;
    }
    const hit = new THREE.Vector3();
    if (!ray.ray.intersectPlane(plane, hit) || hit.distanceTo(camera.position) > 70) return;
    // Clicked ripples use slots 2..5; 0 and 1 belong to the breach.
    const slot = 2 + (rippleNext++ % (RIPPLES - 2));
    rip[slot].set(hit.x, hit.z, clock, 0.9);
    for (let i = 0; i < 36; i++) {
      const j = clickNext++ % CN;
      clickPos.set([hit.x + (Math.random() - 0.5) * 0.3, 0.05, hit.z + (Math.random() - 0.5) * 0.3], j * 3);
      clickVel.set([(Math.random() - 0.5) * 1.8, 2 + Math.random() * 2.6, (Math.random() - 0.5) * 1.8], j * 3);
      clickLife[j] = 0.9 + Math.random() * 0.5;
    }
    if (!running) draw();
  });

  // ---- one frame ----
  let clock = 0;
  const q = new THREE.Quaternion(), zAxis = new THREE.Vector3(0, 0, 1);
  const tmp = new THREE.Vector3();
  function draw() {
    const p = progress;
    lean.x += (lean.tx - lean.x) * 0.06;
    lean.y += (lean.ty - lean.y) * 0.06;
    cameraAt(p);
    camera.position.copy(camPos).add(tmp.set(lean.x * 0.55, -lean.y * 0.25, 0));
    camera.lookAt(camLook.x + lean.x * 0.25, camLook.y - lean.y * 0.12, camLook.z);
    skyMesh.position.copy(camera.position);
    waterMat.uniforms.uTime.value = clock;

    // Shot B: the breach, scrubbed by scroll.
    const s = clamp01((p - SHOT_B[0]) / (SHOT_B[1] - SHOT_B[0]));
    const w = whaleAt(s);
    whale.visible = s > 0 && s < 1;
    whale.position.set(w.x, w.y, w.z);
    const heading = Math.atan2(13.2 * (1 - 2 * s), 8.4);
    const roll = Math.PI * 2 * ease(clamp01((s - 0.36) / 0.28));
    whale.quaternion.copy(camera.quaternion).multiply(q.setFromAxisAngle(zAxis, heading - roll));
    // Its two splashes, as ring waves whose age follows the scroll.
    [sCross, 1 - sCross].forEach((s0, i) => {
      const age = (s - s0) * BREACH_SECONDS;
      const at = whaleAt(s0);
      rip[i].set(at.x, at.z, age > 0 ? clock - age : clock + 99, i ? 1.3 : 1);
    });

    // Spray: ballistic from its splash, then gathered into the heart in shot C.
    const gather = clamp01((p - 0.6) / 0.17);
    const pulse = p > 0.77 ? 1 + 0.1 * Math.sin(clamp01((p - 0.77) / 0.05) * Math.PI) : 1;
    for (let i = 0; i < N; i++) {
      const pt = parts[i];
      let age = (s - pt.s0) * BREACH_SECONDS;
      if (gather > 0) age = (1 - pt.s0) * BREACH_SECONDS;
      if (age <= 0 && gather <= 0) { sprayPos[i * 3 + 1] = -999; continue; }
      const fa = Math.max(0, Math.min(age, 1.1));
      let x = pt.o.x + pt.v.x * fa, y = Math.max(0.02, pt.o.y + pt.v.y * fa - 4.6 * fa * fa), z = pt.o.z + pt.v.z * fa;
      const k = easeIO(clamp01((gather - pt.delay) / (1 - 0.25)));
      if (k > 0) {
        x += (pt.t.x - x) * k; y += (pt.t.y - y) * k; z += (pt.t.z - z) * k;
        if (k >= 1) { x = HEART.x + (x - HEART.x) * pulse; y = HEART.y + (y - HEART.y) * pulse; }
      }
      // A breath of drift so the formed heart shimmers.
      if (k >= 1) { x += Math.sin(clock * 2 + i) * 0.006; y += Math.cos(clock * 1.7 + i) * 0.006; }
      sprayPos[i * 3] = x; sprayPos[i * 3 + 1] = y; sprayPos[i * 3 + 2] = z;
    }
    // In shot D the heart sinks and fades into the sea.
    spray.material.opacity = 1 - clamp01((p - 0.88) / 0.1);
    sprayGeo.attributes.position.needsUpdate = true;

    // Clicked spray, in real time.
    for (let j = 0; j < CN; j++) {
      if (clickLife[j] <= 0) continue;
      clickLife[j] -= 1 / 60;
      clickVel[j * 3 + 1] -= 9.8 / 60;
      clickPos[j * 3] += clickVel[j * 3] / 60;
      clickPos[j * 3 + 1] += clickVel[j * 3 + 1] / 60;
      clickPos[j * 3 + 2] += clickVel[j * 3 + 2] / 60;
      if (clickPos[j * 3 + 1] < 0 || clickLife[j] <= 0) { clickLife[j] = 0; clickPos[j * 3 + 1] = -999; }
    }
    clickGeo.attributes.position.needsUpdate = true;

    renderer.render(scene, camera);

    // Captions follow the same progress (the still version keeps just the headline, set in CSS).
    if (story.classList.contains("still")) return;
    for (const c of caps) {
      const from = +c.dataset.from, to = +c.dataset.to;
      const fade = 0.05;
      const o = from === 0 ? 1 - clamp01((p - (to - fade)) / fade) : clamp01((p - from) / fade) * (1 - clamp01((p - (to - fade)) / fade));
      c.style.opacity = o.toFixed(3);
      c.style.transform = `translateY(${((1 - o) * (p < from ? 16 : -16)).toFixed(1)}px)`;
      c.style.visibility = o > 0.01 ? "visible" : "hidden";
    }
    hint.style.opacity = p < 0.03 ? "1" : "0";
  }

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 1.75);
    renderer.setPixelRatio(dpr);
    renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
    camera.aspect = canvas.clientWidth / Math.max(1, canvas.clientHeight);
    // Narrow screens see a little wider so the breach fits.
    camera.fov = camera.aspect < 0.8 ? 62 : 45;
    camera.updateProjectionMatrix();
    readScroll();
    if (!running) draw();
  }
  addEventListener("resize", resize);

  // Animate only while the stage is on screen; the still version draws once.
  let running = false, last = 0, visible = true;
  new IntersectionObserver(([e]) => {
    visible = e.isIntersecting;
    if (visible && !reduce && !running) { running = true; last = performance.now(); requestAnimationFrame(loop); }
  }).observe(story);
  function loop(now) {
    if (!visible) { running = false; return; }
    clock += Math.min(0.05, (now - last) / 1000);
    last = now;
    draw();
    requestAnimationFrame(loop);
  }
  resize();
  if (reduce) { clock = 2.4; draw(); }
})();
</script>
</body>
</html>
